---
import { profile } from '../data/profile';
import SocialLinks from './SocialLinks.astro';
import RotatingMajor from './RotatingMajor';
import Particles from './Particles.astro';

const [firstName, ...lastName] = profile.fullName.split(' ');
const roles = [
  ...profile.programs.majors.map((major) => `${major} Major`),
  `${profile.programs.minor} Minor`,
];
---

<section id="home" aria-labelledby="hero-heading" class="relative isolate flex min-h-svh flex-col items-center justify-center overflow-hidden border-b border-line bg-obsidian px-5 pt-20 pb-28 text-center sm:px-8">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_0%_0%,#2563a833,transparent_60%),radial-gradient(ellipse_at_100%_80%,#174a7c18,transparent_55%)]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -top-[8%] -left-[45%] -z-10 h-[45%] w-[125%] rotate-[38deg] bg-[radial-gradient(ellipse_at_center,#b5cdeb3d_0%,#608ac733_25%,#144c8c1f_48%,transparent_70%)] blur-3xl"></div>
  <Particles variant="hero" />
  <div class="w-full max-w-6xl">
    <p class="mb-6 text-xs leading-relaxed tracking-[0.2em] text-muted uppercase motion-safe:animate-enter sm:text-sm">{profile.hero.greeting}</p>
    <h1 id="hero-heading" class="text-[clamp(3.25rem,8.2vw,7.75rem)] leading-[1.04] font-bold tracking-[-0.055em]">
      <span class="block overflow-hidden pb-1 sm:inline-block sm:pr-3"><span class="inline-block motion-safe:animate-name">{firstName}</span></span>
      <span class="block overflow-hidden pb-1 text-accent sm:inline-block"><span class="inline-block motion-safe:animate-name motion-safe:[animation-delay:100ms]">{lastName.join(' ')}</span></span>
    </h1>
    <div class="mt-7 motion-safe:animate-enter motion-safe:[animation-delay:220ms]">
      <RotatingMajor roles={roles} accessibleLabel={`${profile.programs.majors.join(' and ')} double major with a ${profile.programs.minor} minor at the ${profile.university}.`} client:load />
    </div>
    <div class="mt-10 flex justify-center motion-safe:animate-enter motion-safe:[animation-delay:320ms]">
      <a href="#about" data-hero-cta class="group relative isolate inline-flex min-h-14 overflow-hidden rounded-lg border border-accent/40 bg-obsidian p-px text-sm text-ivory hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-safe:transition-[border-color,translate] motion-safe:duration-200 motion-safe:hover:-translate-y-1">
        <span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 -z-10 size-[320px] -translate-x-1/2 -translate-y-1/2 bg-[conic-gradient(from_0deg,transparent_0deg,transparent_210deg,#477ebd_275deg,#dbeaff_320deg,transparent_360deg)] motion-safe:animate-border-orbit"></span>
        <span class="relative flex w-full items-center justify-center gap-4 rounded-[6px] bg-obsidian px-7 py-4 transition-colors group-hover:bg-surface motion-reduce:transition-none">
          Show me around
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4 text-accent motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 3-7 18-4-7-7-4 18-7ZM21 3 10 14" /></svg>
        </span>
      </a>
    </div>
    <div class="mt-9 motion-safe:animate-enter motion-safe:[animation-delay:420ms]">
      <SocialLinks />
    </div>
  </div>
</section>
