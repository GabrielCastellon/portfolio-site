---
import { profile } from '../data/profile';
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-4 text-xs leading-relaxed text-muted sm:px-8">
    <p>© {new Date().getFullYear()} {profile.fullName}</p>
    <a href="/#home" class="inline-flex min-h-10 items-center gap-3 transition-colors hover:text-accent motion-reduce:transition-none">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>
