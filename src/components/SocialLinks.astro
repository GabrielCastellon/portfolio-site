---
import { profile } from '../data/profile';

const socialLinks = [
  { name: 'GitHub', href: profile.contact.github },
  { name: 'LinkedIn', href: profile.contact.linkedin },
].filter(({ href }) => href.startsWith('https://'));
---

{socialLinks.length > 0 && (
  <ul aria-label="Social profiles" class="flex items-center justify-center gap-4">
    {socialLinks.map(({ name, href }) => (
      <li>
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${name} profile (opens in a new tab)`} title={name} class="group flex size-12 items-center justify-center rounded-md border border-line text-ivory hover:border-accent hover:bg-primary hover:text-white focus-visible:border-accent motion-safe:transition-[background-color,border-color,color,translate] motion-safe:duration-200 motion-safe:hover:-translate-y-1">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="23" height="23" fill="currentColor" class="size-[23px]">
            {name === 'GitHub' ? (
              <path d="M12 .5a12 12 0 0 0-3.793 23.384c.6.111.82-.26.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.303-5.467-1.334-5.467-5.933 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.51 11.51 0 0 1 6.008 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.611-2.807 5.627-5.479 5.924.43.372.823 1.102.823 2.222v3.293c0 .32.216.694.825.576A12.002 12.002 0 0 0 12 .5Z" />
            ) : (
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
            )}
          </svg>
        </a>
      </li>
    ))}
  </ul>
)}
