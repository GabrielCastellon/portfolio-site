---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Panel from './Panel.astro';

const { email, github, linkedin, invitation } = profile.contact;
function httpsLink(value: string) {
  try {
    const url = new URL(value);
    return url.protocol === 'https:' ? url.href : undefined;
  } catch {
    return undefined;
  }
}
const links = [
  { label: 'Email', href: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? `mailto:${email}` : undefined },
  { label: 'LinkedIn', href: httpsLink(linkedin) },
  { label: 'GitHub', href: httpsLink(github) },
].filter(({ href }) => href);
const hasContact = links.length > 0;
---

<Panel id="contact" labelledby="contact-heading" class="bg-[radial-gradient(ellipse_at_100%_0%,#386eab30,transparent_65%)]">
  <SectionHeading title="Let’s connect" id="contact-heading" number="05" />
  <div class="px-6 pt-5 pb-7 sm:px-8">
    <p class="max-w-2xl text-base leading-relaxed text-muted">{invitation}</p>
    {!hasContact && <p class="mt-3 text-xs leading-relaxed text-muted">Contact details will be available here soon.</p>}
    <ul class="mt-5 flex flex-wrap gap-3">
      {links.map(({ label, href }) => (
        <li class="grow sm:grow-0">
          <a href={href} class="group inline-flex min-h-11 w-full items-center justify-center gap-3 rounded-lg border border-accent/25 bg-primary/25 px-5 py-3 text-sm text-accent hover:border-accent/60 hover:bg-primary/50 hover:text-ivory motion-safe:transition-[border-color,background-color,translate] motion-safe:duration-200 motion-safe:hover:-translate-y-0.5">
            {label}<span aria-hidden="true" class="motion-safe:transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Panel>
