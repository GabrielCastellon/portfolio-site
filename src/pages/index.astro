---
import Portfolio from '../layouts/Portfolio.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Sidebar from '../components/Sidebar.astro';
import Particles from '../components/Particles.astro';
---

<Portfolio>
  <Hero />
  <div class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_0%_20%,#2563a81f,transparent_45%),radial-gradient(ellipse_at_100%_75%,#4f7fb014,transparent_40%)]"></div>
    <Particles variant="content" />
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid items-start gap-6 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-8"><About /></div>
        <div class="min-w-0 lg:col-span-4"><Sidebar /></div>
        <div class="grid min-w-0 gap-6 lg:col-span-12 lg:grid-cols-2">
          <Experience />
          <Projects />
        </div>
        <div class="min-w-0 lg:col-span-12"><Skills /></div>
        <div class="min-w-0 lg:col-span-12"><Contact /></div>
      </div>
    </div>
  </div>
</Portfolio>
