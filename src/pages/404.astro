---
import Portfolio from '../layouts/Portfolio.astro';
---

<Portfolio title="Page not found | Gabriel Castellon" description="This page could not be found. Return to Gabriel’s portfolio." noindex>
  <section class="mx-auto flex min-h-svh max-w-6xl flex-col justify-center px-5 py-24 sm:px-8" aria-labelledby="not-found-heading">
    <p class="mb-4 font-mono text-xs text-accent">404 / Page not found</p>
    <h1 id="not-found-heading" class="text-4xl leading-tight tracking-tight sm:text-5xl">Nothing here, just yet.</h1>
    <p class="mt-5 max-w-md text-base leading-relaxed text-muted">The page you’re looking for may have moved. Let’s get you back to the portfolio.</p>
    <a href="/" class="mt-6 inline-flex min-h-11 w-fit items-center gap-5 border-b border-line py-2 text-sm text-accent transition-colors hover:text-ivory motion-reduce:transition-none">Back home <span aria-hidden="true">↗</span></a>
  </section>
</Portfolio>
